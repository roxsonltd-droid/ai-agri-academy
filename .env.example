# AgriNexus Environment Variables

See **`docs/ENVIRONMENT.md`** for Doppler, layered `.env` files, and OpenAPI URLs.

# Mistral AI API Key for the Agent Mesh (LangGraph)
# Get your API key here: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# Helicone AI Gateway (OpenAI-compatible); чат LLM през gateway + observability (виж backend/core/llm_factory.py)
# HELICONE_API_KEY=
# HELICONE_GATEWAY_BASE_URL=https://ai-gateway.helicone.ai/v1
# HELICONE_GATEWAY_MODEL=mistral/mistral-large-latest (default: mistral-small-latest where not set)
# MISTRAL_ORCHESTRATOR_MODEL=mistral-small-latest
# MISTRAL_MARKET_AGENT_MODEL=mistral-small-latest
# MISTRAL_WEATHER_AGENT_MODEL=mistral-small-latest
# MISTRAL_CROP_AGENT_MODEL=mistral-small-latest
# MISTRAL_FIELD_AGENT_MODEL=mistral-small-latest
# MISTRAL_OPERATIONS_AGENT_MODEL=mistral-small-latest
# MISTRAL_FINANCE_AGENT_MODEL=mistral-small-latest
# MISTRAL_COMPLIANCE_AGENT_MODEL=mistral-small-latest
# MISTRAL_SUSTAINABILITY_AGENT_MODEL=mistral-small-latest
# MISTRAL_NEWS_AGENT_MODEL=mistral-small-latest
# MISTRAL_ACADEMY_AGENT_MODEL=mistral-small-latest
# MISTRAL_GENERAL_AGENT_MODEL=mistral-small-latest
# MISTRAL_ACADEMY_TUTOR_MODEL=mistral-small-latest
# MISTRAL_MESH_MODEL=mistral-small-latest

# Rate limits (requests per IP per minute)
# AGN_MESH_RATE_LIMIT_PER_MIN=40
# AGN_ACADEMY_RATE_LIMIT_PER_MIN=30

# Required by apps/web API proxy routes in production. Use the deployed root marketing/API origin.
# Local development falls back to http://127.0.0.1:3456.
# AGN_MARKETING_ORIGIN=https://your-marketing-domain.example

# Fieldlot smoke: set to 1 in CI when API is running to enforce HTTP checks
# FIELDLOT_SMOKE_STRICT=0

# Other keys if needed in the future
# OPENAI_API_KEY=

# --- Per-app examples (copy into apps/<name>/.env) ---
# apps/web/.env.example — Next.js + Supabase
# apps/backend/.env.example — FastAPI + DB + RAG
# apps/mobile/.env.example — Expo

# =============================================================================
# Optional — merged from origin/main (Clerk, Pinecone, Cloudflare, ElevenLabs, Roboflow)
# See docs/POSTGRES.md, docs/LANGCHAIN_VECTOR_DB.md, etc. when using that stack.
# =============================================================================

# --- PostgreSQL (alternate docker-compose from origin) ---
# DATABASE_URL=postgresql+psycopg2://agro:agro_dev_change_me@localhost:5432/agro_academy
# Управлявана база (SSL): ...?sslmode=require

# --- Clerk (frontend + backend verify) ---
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_CLERK_ENFORCE=false
# CLERK_JWKS_URL=https://<your-subdomain>.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://<your-subdomain>.clerk.accounts.dev
# CLERK_JWT_AUDIENCE=

# --- Pinecone + LlamaIndex (docs/LANGCHAIN_VECTOR_DB.md) ---
# PLATFORM_RAG_BACKEND=llamaindex
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=agro-academy

# --- Weaviate + LangChain ---
# PLATFORM_RAG_BACKEND=weaviate
# WEAVIATE_URL=
# WEAVIATE_API_KEY=

# --- Cloudflare Stream (docs/CLOUDFLARE_STREAM.md) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_STREAM_API_TOKEN=

# --- Cloudflare R2 (docs/CLOUDFLARE_R2.md) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://<bucket>.<accountid>.r2.cloudflarestorage.com
# R2_PRESIGN_EXPIRES_SECONDS=900
# R2_DELETE_AFTER_INGEST=true

# --- ElevenLabs TTS (docs/ELEVENLABS_VOICE.md) ---
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# VOICE_TTS_MAX_CHARS=4000
# VOICE_TTS_SECRET=

# --- Roboflow (docs/ROBOFLOW_VISION.md) ---
# ROBOFLOW_API_KEY=
# ROBOFLOW_WORKSPACE=
# ROBOFLOW_PROJECT=
# ROBOFLOW_VERSION=1
# ROBOFLOW_CONFIDENCE=0.4
# ROBOFLOW_IMAGE_MAX_BYTES=5242880
# ROBOFLOW_SERVERLESS_BASE=https://serverless.roboflow.com
# ROBOFLOW_INFER_SECRET=
