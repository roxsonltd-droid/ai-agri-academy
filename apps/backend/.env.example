DATABASE_URL=postgresql://agrinexus:agrinexus_dev@127.0.0.1:5432/agrinexus
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081
JWT_SECRET=change-me-in-production

# Academy RAG (optional). ``apps/backend/ai`` — Supabase Postgres + pgvector + OpenAI embeddings.
# POSTGRES_CONNECTION_STRING=postgresql://user:pass@host:5432/db
# ACADEMY_QUIZ_USE_RAG_COMPRESSION=false  # true: quiz generation използва RAGEngine + LLM contextual compression (по-бавно, по-малко шум)
# QUIZ_STRUCTURED_INVOKE_RETRIES=2      # повторни опити при грешка или празен списък въпроси (1–5)

# ACADEMY_RAG_BACKEND=auto   # auto | ai | file | pg
#   auto: use ai RAG when DATABASE_URL + OPENAI_API_KEY; else LangChain PG; else file TF–IDF
# ACADEMY_CONTENT_ROOT=C:/path/to/agrinexus-final/content/academy/courses
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_EMBED_MODEL=text-embedding-3-small
# AI_CHUNKS_TABLE=ai_course_chunks
# AI_EMBEDDING_DIMENSIONS=1536
# Ingest: cd apps/backend && python -m ai --truncate

# Supabase Auth — Bearer verification (same JWT secret as Dashboard → Settings → API)
# SUPABASE_JWT_SECRET=your-jwt-secret
# SUPABASE_JWT_AUDIENCE=authenticated

# LangGraph tutor draft node (`POST /api/tutor/graph`) — optional live LLM
# MISTRAL_API_KEY=
# MISTRAL_TUTOR_MODEL=mistral-small-latest

# --- Production LLM (rag/core/llm.py) ---
# LLM_PROVIDER=openai          # openai | xai | grok | anthropic
# OPENAI_CHAT_MODEL=gpt-4o     # or gpt-4o-mini for dev
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1500
# ReAct tools (`POST /api/react/run`): CME цени — опционално `pip install yfinance`
# FEATURE_TUTOR_REACT_TOOLS=true
# ReAct: опционален компресиран RAG tool (LLM след retrieval; по-бавно)
# FEATURE_REACT_RAG_COMPRESSED=false
# ACADEMY_COMPRESSION_FETCH_K=12
# ACADEMY_COMPRESSION_MAX_DOCS=8
# ACADEMY_COMPRESSION_PASSAGE_CHARS=12000
# ReAct RAG: RAGEngine (PGVector/Supabase) + fallback legacy retriever
# REACT_RAG_MODE=auto          # auto | engine | retriever
# REACT_RAG_TOP_K=6
# REACT_RAG_TOOL_MAX_CHARS=6000
# Grok (OpenAI-compatible xAI API):
# LLM_PROVIDER=xai
# XAI_API_KEY=
# XAI_CHAT_MODEL=grok-2-latest
# XAI_API_BASE=https://api.x.ai
# Claude (pip install langchain-anthropic):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Embeddings (HF e5 for BG) — optional; see docs/AI-PRODUCTION-STACK.md
# RAG_HF_EMBED_MODEL=intfloat/multilingual-e5-large

# Chunking: recursive (default) | semantic | smart | hierarchical (parent+child)
# ACADEMY_CHUNK_STRATEGY=recursive
# Retrieval: flat (default) | parent_child (изисква ingest с hierarchical чънкове)
# ACADEMY_RETRIEVAL_MODE=flat
# Optional: langchain-experimental for semantic/smart
# ACADEMY_SEMANTIC_BREAKPOINT_PERCENTILE=85
# ACADEMY_SEMANTIC_MIN_CHARS=200
# ACADEMY_SEMANTIC_FALLBACK_MAX_CHARS=1500
# ACADEMY_SEMANTIC_FALLBACK_CHUNK_SIZE=800
# ACADEMY_SEMANTIC_FALLBACK_CHUNK_OVERLAP=150
# ACADEMY_HIER_PARENT_CHUNK_SIZE=2000
# ACADEMY_HIER_PARENT_OVERLAP=400
# ACADEMY_HIER_CHILD_CHUNK_SIZE=600
# ACADEMY_HIER_CHILD_OVERLAP=100
# ACADEMY_USE_MINIMAL_CHUNKER=true  # само при проблемни native deps (пр. Py3.14 + sklearn)
# ACADEMY_LLM_CHUNK_MAX_INPUT_CHARS=12000

# RAG vector backend: pgvector (DATABASE_URL / POSTGRES_CONNECTION_STRING) | supabase (Supabase client + RPC)
# RAG_VECTOR_BACKEND=pgvector
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...   # за браузър/SDK; RAG на сървъра ползва service role
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_RAG_TABLE=documents
# SUPABASE_RAG_MATCH_FN=match_documents
# VECTOR_STORE_TABLE=documents       # същата като SUPABASE_RAG_TABLE по подразбиране
# VECTOR_STORE_MATCH_FN=             # по подразбиране: match_documents (documents) или match_academy_documents (academy_documents)
# ACADEMY_DEFAULT_REGION=bulgaria    # metadata при ingest (LangChain loaders)
# ACADEMY_CONTENT_DIFFICULTY=intermediate
# VECTOR_STORE_INGEST_BATCH=50
# POSTGRES_CONNECTION_STRING=postgresql://postgres.[ref]:[pass]@aws-0-[region].pooler.supabase.com:5432/postgres
# Миграция: apps/backend/migrations/003_supabase_vector_documents.sql (vector dim 1024 = e5-large; OpenAI = 1536 — смени и в SQL)
# Опционално: apps/backend/migrations/004_academy_documents_vector.sql — таблица academy_documents + match_academy_documents
# Ingest в Supabase: cd apps/backend && python scripts/ingest_academy.py [--rebuild]

# Memory: Redis (sessions / cache; wire in app when ready)
# REDIS_URL=redis://localhost:6379/0
# ACADEMY_RAG_CACHE_ENABLED=true
# ACADEMY_RAG_CACHE_TTL_SECONDS=1200
# ACADEMY_RAG_CACHE_PREFIX=agri:rag:v1
# ACADEMY_RAG_CACHE_BUMP=   # смени за глобално „изхвърляне“ на стари RAG кеш ключове без SCAN
